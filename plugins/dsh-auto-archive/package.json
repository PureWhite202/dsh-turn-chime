{
  "name": "dsh-auto-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件：每次启动时把默认工作区里未置顶、且超过设定时间未活动的对话自动归档",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
