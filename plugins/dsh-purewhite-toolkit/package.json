{
  "name": "dsh-purewhite-toolkit",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "纯白莱茵自用 DSH 工具集：screenshot 工具（整屏 / 窗口 / 区域截图）与内置技能 sync-config（对比本机与云端配置仓库）。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "native",
    "build/dshtool-capture.exe",
    "scripts",
    "test",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build-helper.mjs",
    "test": "node scripts/build-helper.mjs && node test/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "screenshot",
    "windows",
    "macos"
  ],
  "license": "MIT"
}
